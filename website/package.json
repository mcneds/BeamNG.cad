{
  "name": "beamng-cad-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "node scripts/doc-evidence.mjs && astro build && node scripts/check-links.mjs",
    "docs:check": "node scripts/doc-evidence.mjs --strict",
    "docs:review": "node scripts/doc-evidence.mjs --review",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8",
    "three": "0.186.1"
  },
  "overrides": {
    "postcss-nested": "7.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/three": "0.186.0",
    "cheerio": "^1.1.2",
    "typescript": "^5.9.3",
    "wrangler": "4.149.0"
  }
}
